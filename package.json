{
  "name": "initium",
  "version": "0.0.0",
  "license": "GPL-3.0",
  "scripts": {
    "webpack": "source config/env && webpack --progress",
    "start": "export NODE_OPTIONS='--no-webstorage' && npm run dist && npm run webpack -- --watch",
    "dist": "rm -rf dist && mkdir dist",
    "test": "export NODE_OPTIONS='--no-webstorage' && vitest",
    "test-once": "vitest run",
    "build": "export NODE_OPTIONS='--no-webstorage' && npm run test-once && npm run dist && npm run webpack -- --env prod && node build.js"
  },
  "dependencies": {
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "city-timezones": "^1.3.4",
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "type-fest": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.7",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jsdom": "^31.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.33",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-mixins": "^12.1.2",
    "postcss-preset-env": "^11.6.2",
    "raw-loader": "^4.0.2",
    "react-compiler-webpack": "^1.1.0",
    "source-map-loader": "^5.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^10.0.0-beta.0",
    "typescript": "^7.1.0-beta",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "browserslist": [
    "Chrome >= 140"
  ]
}
